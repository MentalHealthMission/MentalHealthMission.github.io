@prefix odim: <http://connectdigitalstudy.com/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://connectdigitalstudy.com/ontology/descriptions/wearables>
  a owl:Ontology ;
  owl:imports <http://connectdigitalstudy.com/ontology/odim-mh-wearables> .

# Evidence: typed values and metric annotations extracted from connect_stream_semantics.ttl.
odim:AcquisitionInterface
  rdfs:comment "An interface through which wearable or phone data are acquired from a source system."@en .

odim:CollectionFamily
  rdfs:comment "A family used to group related wearable or phone data collections."@en .

odim:DataRole
  rdfs:comment "A role distinguishing the function of data, such as measurement data or device metadata."@en .

odim:DeviceEcosystem
  rdfs:comment "A device vendor ecosystem associated with wearable or phone data."@en .

odim:MeasuredQuantity
  rdfs:comment "A classification stating what a metric definition measures or describes."@en .

odim:MeasureKind
  rdfs:comment "A classification of a metric as a measured quantity, multidimensional measure, or temporal measure."@en .

odim:MeasurementDomain
  rdfs:comment "A broad domain used to classify what a wearable or phone metric concerns."@en .

odim:MetricDefinition
  rdfs:comment "A definition that identifies and describes a named metric or data product."@en .

# Evidence: platform declarations in ontology/connect/extension/platforms.owl.
odim:Platform
  rdfs:comment "An operating-system or device platform referenced by a metric definition."@en .

# Evidence: direct metric annotations in connect_stream_semantics.ttl and sleep-feature annotations in connect_extension.owl.
odim:hasCollectionFamily
  rdfs:comment "Associates a metric definition with the collection family to which its data source belongs."@en .

odim:hasDataRole
  rdfs:comment "Associates a metric definition with the role its data plays, such as measurement or device metadata."@en .

odim:hasDeviceEcosystem
  rdfs:comment "Associates a metric definition with its related device vendor ecosystem."@en .

odim:hasMeasuredQuantity
  rdfs:comment "Associates a metric definition with the quantity or subject that its records measure or describe."@en .

odim:hasMeasureKind
  rdfs:comment "Associates a metric definition with the kind of measure represented by its data product."@en .

odim:hasMeasurementDomain
  rdfs:comment "Associates a metric definition with a broad measurement domain that its data concerns."@en .

odim:isDisruptive
  rdfs:comment "Indicates whether a derived sleep feature is classified as disruptive."@en .

odim:platform
  rdfs:comment "Associates a metric definition with its operating-system or device platform."@en .

odim:usesAcquisitionInterface
  rdfs:comment "Associates a metric definition with the interface through which its data are acquired."@en .
