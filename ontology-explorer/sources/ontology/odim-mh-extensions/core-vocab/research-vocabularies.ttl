  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Delayed Sleep Phase"@en ;
  skos:broader odim:SleepPhenotype .

odim:InsomniaSymptom
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Insomnia Symptom"@en ;
  skos:broader odim:SleepPhenotype .

odim:SleepIrregularity
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Sleep Irregularity"@en ;
  skos:broader odim:SleepPhenotype .

odim:SocialPhenotype
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Social Phenotype"@en ;
  skos:topConceptOf odim:PhenotypeScheme .

