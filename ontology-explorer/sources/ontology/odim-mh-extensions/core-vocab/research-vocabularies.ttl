  skos:prefLabel "Inference Rule"@en ;
  skos:topConceptOf odim:ComputationApproachScheme .

odim:ModelBasedComputation
  a skos:Concept ;
  skos:inScheme odim:ComputationApproachScheme ;
  skos:prefLabel "Model-based Computation"@en ;
  skos:topConceptOf odim:ComputationApproachScheme .

odim:SensingActivity
  a skos:Concept ;
  skos:inScheme odim:ComputationApproachScheme ;
  skos:prefLabel "Sensing Activity"@en ;
  skos:topConceptOf odim:ComputationApproachScheme .

odim:ResponseFormatScheme
  a skos:ConceptScheme ;
  skos:prefLabel "Response formats"@en ;
  skos:definition "Forms in which questionnaire answers are expressed."@en ;
  skos:hasTopConcept
    odim:LikertFormat,
    odim:MultipleChoiceFormat,
    odim:SliderFormat,
    odim:TextFormat .

odim:LikertFormat
  a skos:Concept ;
  skos:inScheme odim:ResponseFormatScheme ;
  skos:prefLabel "Likert Format"@en ;
  skos:topConceptOf odim:ResponseFormatScheme .

odim:MultipleChoiceFormat
  a skos:Concept ;
  skos:inScheme odim:ResponseFormatScheme ;
  skos:prefLabel "Multiple Choice Format"@en ;
  skos:topConceptOf odim:ResponseFormatScheme .

odim:SliderFormat
  a skos:Concept ;
  skos:inScheme odim:ResponseFormatScheme ;
  skos:prefLabel "Slider Format"@en ;
