  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Weekly Interval"@en ;
  skos:broader odim:TimeInterval .

odim:PhenotypeScheme
  a skos:ConceptScheme ;
  skos:prefLabel "Phenotypes and risk"@en ;
  skos:definition "Digital phenotypes concerning activity, mood, sleep, social behaviour and risk."@en ;
  skos:hasTopConcept
    odim:ActivityPhenotype,
    odim:MoodPhenotype,
    odim:RiskPhenotype,
    odim:SleepPhenotype,
    odim:SocialPhenotype .

odim:ActivityPhenotype
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Activity Phenotype"@en ;
  skos:topConceptOf odim:PhenotypeScheme .

odim:ActivityFlattening
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Activity Flattening"@en ;
  skos:broader odim:ActivityPhenotype .

odim:Hyperactivity
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Hyperactivity"@en ;
  skos:broader odim:ActivityPhenotype .

odim:PhysicalInactivity
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Physical Inactivity"@en ;
  skos:broader odim:ActivityPhenotype .

