@prefix odim: <http://connectdigitalstudy.com/ontology#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://connectdigitalstudy.com/ontology/research-vocabularies>
  a owl:Ontology ;
  rdfs:label "ODIM-MH core research vocabularies"@en ;
  owl:imports <http://connectdigitalstudy.com/ontology> .

# These schemes promote existing core class IRIs for vocabulary browsing. They
# preserve, rather than replace or extend, the source OWL class hierarchy.
odim:ObservationContextScheme
  a skos:ConceptScheme ;
  skos:prefLabel "Observation contexts"@en ;
  skos:definition "Temporal and situational context in which observations apply."@en ;
  skos:hasTopConcept odim:ContextualSituation, odim:EventWindow, odim:TimeInterval .

odim:ContextualSituation
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Contextual Situation"@en ;
  skos:topConceptOf odim:ObservationContextScheme .

odim:AtHome
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "At Home"@en ;
  skos:broader odim:ContextualSituation .

odim:ExerciseSession
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Exercise Session"@en ;
  skos:broader odim:ContextualSituation .

odim:FamilyVisit
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Family Visit"@en ;
  skos:broader odim:ContextualSituation .

odim:HolidayPeriod
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Holiday Period"@en ;
  skos:broader odim:ContextualSituation .

odim:HomeAlone
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Home Alone"@en ;
  skos:broader odim:ContextualSituation .

odim:MedicalEvent
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Medical Event"@en ;
  skos:broader odim:ContextualSituation .

odim:NightTime
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Night Time"@en ;
  skos:broader odim:ContextualSituation .

odim:PublicEvent
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Public Event"@en ;
  skos:broader odim:ContextualSituation .

odim:SleepEnvironment
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Sleep Environment"@en ;
  skos:broader odim:ContextualSituation .

odim:SocialEvent
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Social Event"@en ;
  skos:broader odim:ContextualSituation .

odim:WeatherCondition
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Weather Condition"@en ;
  skos:broader odim:ContextualSituation .

odim:Weekend
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Weekend"@en ;
  skos:broader odim:ContextualSituation .

odim:WorkOrStudy
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Work Or Study"@en ;
  skos:broader odim:ContextualSituation .

odim:EventWindow
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Event Window"@en ;
  skos:topConceptOf odim:ObservationContextScheme .

odim:PostDischargePeriod
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Post-discharge Period"@en ;
  skos:broader odim:EventWindow .

odim:PreRelapsePeriod
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Pre-relapse Period"@en ;
  skos:broader odim:EventWindow .

odim:TimeInterval
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Time Interval"@en ;
  skos:topConceptOf odim:ObservationContextScheme .

odim:DailyInterval
  a skos:Concept ;
  skos:inScheme odim:ObservationContextScheme ;
  skos:prefLabel "Daily Interval"@en ;
