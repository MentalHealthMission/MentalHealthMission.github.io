odim:ComputationApproachScheme
  a skos:ConceptScheme ;
  skos:prefLabel "Computation approaches"@en ;
  skos:definition "Approaches to acquiring observations, computing features and inferring phenotypes."@en ;
  skos:hasTopConcept
    odim:AlgorithmicComputation,
    odim:BlackBoxComputation,
    odim:InferenceRule,
    odim:ModelBasedComputation,
    odim:SensingActivity .

odim:AlgorithmicComputation
  a skos:Concept ;
  skos:inScheme odim:ComputationApproachScheme ;
  skos:prefLabel "Algorithmic Computation"@en ;
  skos:topConceptOf odim:ComputationApproachScheme .

odim:BlackBoxComputation
  a skos:Concept ;
  skos:inScheme odim:ComputationApproachScheme ;
  skos:prefLabel "Black-box Computation"@en ;
