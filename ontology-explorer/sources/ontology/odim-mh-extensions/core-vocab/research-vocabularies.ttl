  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Elevated Mood"@en ;
  skos:broader odim:MoodPhenotype .

odim:LowMood
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Low Mood"@en ;
  skos:broader odim:MoodPhenotype .

odim:MoodInstability
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Mood Instability"@en ;
  skos:broader odim:MoodPhenotype .

odim:RiskPhenotype
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Risk Phenotype"@en ;
  skos:topConceptOf odim:PhenotypeScheme .

odim:DepressionRisk
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Depression Risk"@en ;
  skos:broader odim:RiskPhenotype .

odim:RelapseRisk
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Relapse Risk"@en ;
  skos:broader odim:RiskPhenotype .

odim:StressRisk
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Stress Risk"@en ;
  skos:broader odim:RiskPhenotype .

odim:SleepPhenotype
  a skos:Concept ;
  skos:inScheme odim:PhenotypeScheme ;
  skos:prefLabel "Sleep Phenotype"@en ;
  skos:topConceptOf odim:PhenotypeScheme .

